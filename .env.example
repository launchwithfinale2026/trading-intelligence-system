# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
# Local dev default (SQLite):
DATABASE_URL=sqlite:///./trading.db
# Production (Postgres) example:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/trading

# Telegram
# Required to actually run the bot (python -m app.telegram.bot). Create one
# via @BotFather in Telegram — this is a human, credentialed step; the API
# server runs fine with this unset, only the bot process needs it.
# TELEGRAM_BOT_TOKEN=

# Automated scanning + alerting. Off by default on purpose: turning this on
# means the system will proactively message real linked users. Only enable
# it once you've decided you want that — see docs/DECISIONS.md.
ENABLE_SCHEDULED_SCANNING=false
SCAN_INTERVAL_SECONDS=900
POSITION_MONITOR_INTERVAL_SECONDS=300

# Auth
# SECRET_KEY must be overridden with a long random value in any deployed
# environment — the default in code is dev-only and insecure.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
